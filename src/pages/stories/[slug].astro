---
import Layout from '../../layouts/Layout.astro';
import { getCollection, render } from 'astro:content'; 

export async function getStaticPaths() {
  const stories = await getCollection('stories');
  return stories.map((story) => ({
    params: { slug: story.id },
    props: { story },
  }));
}

const { story } = Astro.props;
const { Content } = await render(story);

const formattedDate = story.data.date 
  ? new Date(story.data.date).toLocaleDateString('ru-RU', { year: 'numeric', month: 'long', day: 'numeric' })
  : 'Дата не указана';
---

<Layout>
  <main class="py-16 md:py-20 min-h-[600px]">
    
    <div class="max-w-3xl mx-auto text-center mb-12">
      <span class="text-[10px] uppercase font-bold text-emerald-600 tracking-wider">
        Проза &middot; {story.data.tag || 'Рассказ'}
      </span>
      <h2 class="text-4xl md:text-5xl font-bold mt-4 mb-6 font-serif leading-tight text-black">
        {story.data.title}
      </h2>
      <div class="text-sm text-gray-400 flex justify-center items-center gap-3 font-medium">
        <span>{formattedDate}</span>
        <span>•</span>
        <span>{story.data.readingTime || '15 мин чтения'}</span>
      </div>
    </div>

    <!-- Аудиоплеер -->
    {story.data.ambientTrack && story.data.audioFile && (
      <div class="max-w-2xl mx-auto mb-16 bg-gray-50 border border-gray-200 rounded-full p-2 pl-3 flex items-center gap-4 shadow-sm">
        <audio id="ambient-player" src={story.data.audioFile} loop preload="none"></audio>
        <button id="play-btn" class="w-10 h-10 bg-black text-white rounded-full flex items-center justify-center hover:bg-emerald-600 transition-colors">▶</button>
        <div class="flex-1">
          <div class="text-[10px] font-bold uppercase tracking-widest text-gray-500">Фоновое сопровождение</div>
          <div class="text-sm font-medium text-gray-800">{story.data.ambientTrack}</div>
        </div>
      </div>
      <script is:inline>
        const btn = document.getElementById('play-btn');
        const player = document.getElementById('ambient-player');
        if (btn && player) {
          btn.addEventListener('click', () => {
            if (player.paused) { player.play(); btn.innerText = '⏸'; } 
            else { player.pause(); btn.innerText = '▶'; }
          });
        }
      </script>
    )}

    <article class="prose prose-lg prose-gray mx-auto text-gray-800 leading-relaxed font-serif">
      <Content />
    </article>
  </main>
</Layout>