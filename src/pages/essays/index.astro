---
import Layout from '../../layouts/Layout.astro';
import { createReader } from '@keystatic/core/reader';
import keystaticConfig from '../../../keystatic.config';
import { getEntry } from 'astro:content';

const reader = createReader(process.cwd(), keystaticConfig);
const essays = await reader.collections.essays.all();

// Достаем текст описания из админки
const siteData = await getEntry('site', 'settings');
const desc = siteData?.data?.essaysDesc || 'Здесь собраны мои развернутые тексты и заметки.';
---

<Layout>
  <main class="pb-16 min-h-[500px]">
    
    <div class="mb-12 border-b border-gray-100 pb-8">
      <!-- УБРАЛИ ТОЧКУ -->
      <h2 class="text-3xl md:text-4xl font-bold font-serif text-black mb-4">Эссе и заметки</h2>
      <!-- ВЫВОДИМ ТЕКСТ ИЗ АДМИНКИ -->
      <p class="text-gray-600 text-lg max-w-2xl">{desc}</p>
    </div>

    <div class="space-y-12">
      {essays.length === 0 ? (
        <p class="text-gray-500 italic">Пока здесь нет публикаций.</p>
      ) : (
        essays.map((essay) => (
          <article class="group">
            <div class="flex flex-col md:flex-row md:items-baseline gap-2 md:gap-6 mb-2">
              <time class="text-sm font-mono text-gray-400 shrink-0 w-32">{essay.entry.date || 'Без даты'}</time>
              <a href={`/essays/${essay.slug}`} class="block">
                <h3 class="text-2xl font-bold font-serif text-gray-900 group-hover:text-blue-600 transition-colors decoration-2 underline-offset-4 group-hover:underline">
                  {essay.entry.title}
                </h3>
              </a>
            </div>
            <div class="flex flex-col md:flex-row gap-2 md:gap-6">
              <div class="shrink-0 w-32 hidden md:block"></div>
              <div>
                <div class="flex items-center gap-3 text-xs font-semibold uppercase tracking-wider mt-2">
                  <span class="text-blue-600">{essay.entry.tag || 'Заметка'}</span>
                  <span class="text-gray-300">•</span>
                  <span class="text-gray-400 text-[10px]">{essay.entry.readingTime || '5 мин'}</span>
                </div>
              </div>
            </div>
          </article>
        ))
      )}
    </div>
  </main>
</Layout>