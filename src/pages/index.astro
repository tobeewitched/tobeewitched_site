---
import Layout from '../layouts/Layout.astro';
import { getEntry } from 'astro:content';

// Достаем настройки Главной страницы из базы
const homeData = await getEntry('home', 'settings');
const heroTitle = homeData?.data?.heroTitle || 'Исследуя структуры воображения.';
const heroText = homeData?.data?.heroText || 'Привет! Я — исследователь, специализирующийся на системно-коммуникативной теории политического лидерства. Этот сайт — мой цифровой сад, где академическая строгость встречается с литературой и эмбиентом.';
const heroText2 = homeData?.data?.heroText2 || 'В центре моего внимания лежат вопросы конструирования социальных страхов, анализ хабитуса бедности и изучение синтетического ноктюрна через призму структур воображения.';
const heroImage = homeData?.data?.heroImage || 'https://images.unsplash.com/photo-1507003211169-0a1dd7228f2d?ixlib=rb-4.0.3&auto=format&fit=crop&w=800&q=80';
const telegramLink = homeData?.data?.telegramLink || 'https://t.me/';
---

<Layout>
  <main class="py-16 px-10 md:px-20 min-h-[600px]">
    
    <div class="flex flex-col md:flex-row gap-12 items-center md:items-start mb-20">
      
      <!-- ФОТО -->
      <div class="w-full md:w-1/3 shrink-0">
        <div class="aspect-[3/4] bg-gray-100 rounded-sm overflow-hidden shadow-md relative group border border-gray-200">
          <img src={heroImage} alt="Портрет" class="object-cover w-full h-full grayscale group-hover:grayscale-0 transition-all duration-700 ease-in-out" />
        </div>
      </div>
      
      <!-- ТЕКСТЫ -->
      <div class="w-full md:w-2/3 flex flex-col justify-center pt-2">
        <h2 class="text-3xl md:text-4xl font-bold mb-6 font-serif leading-tight text-black">
          {heroTitle}
        </h2>
        <div class="space-y-4 text-gray-600 leading-relaxed text-lg">
          <p>{heroText}</p>
          {heroText2 && <p>{heroText2}</p>}
        </div>
        
        <!-- БЛОК КНОПОК -->
        <div class="mt-8 flex flex-col gap-3 w-fit">
          
          <!-- ВЕРХНИЙ РЯД (Две кнопки) -->
          <div class="flex flex-wrap sm:flex-nowrap gap-3">
            <a href="/essays" class="px-5 py-2.5 bg-black text-white text-sm font-semibold rounded-sm hover:bg-gray-800 transition-colors text-center whitespace-nowrap">
              Читать последние эссе
            </a>
            {telegramLink && (
              <a href={telegramLink} target="_blank" class="px-5 py-2.5 bg-gray-100 text-gray-700 text-sm font-semibold rounded-sm border border-gray-200 hover:bg-gray-200 transition-colors text-center whitespace-nowrap">
                Связаться (Telegram)
              </a>
            )}
          </div>
          
          <!-- НИЖНИЙ РЯД (Широкая кнопка CV) -->
          <a href="/cv.pdf" target="_blank" class="w-full px-5 py-2.5 bg-white border-2 border-black text-black text-sm font-bold rounded-sm hover:bg-gray-50 transition-colors text-center uppercase tracking-widest">
            Смотреть Curriculum Vitae
          </a>
          
        </div>

      </div>
    </div>

  </main>
</Layout>
