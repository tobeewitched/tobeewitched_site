---
import Layout from '../layouts/Layout.astro';
import { getEntry } from 'astro:content';

// Достаем настройки Главной страницы из базы
const homeData = await getEntry('home', 'settings');
const { heroTitle, heroText, heroText2, heroImage, telegramLink } = homeData.data;
---

<Layout>
  <main class="py-16 px-10 md:px-20 min-h-[600px]">
    
    <div class="flex flex-col md:flex-row gap-12 items-center md:items-start mb-20">
      
      <!-- ФОТО -->
      <div class="w-full md:w-1/3 shrink-0">
        <div class="aspect-[3/4] bg-gray-100 rounded-sm overflow-hidden shadow-md relative group border border-gray-200">
          <img src={heroImage} alt="Портрет" class="object-cover w-full h-full grayscale group-hover:grayscale-0 transition-all duration-700 ease-in-out" />
        </div>
      </div>
      
      <!-- ТЕКСТЫ ИЗ АДМИНКИ -->
      <div class="w-full md:w-2/3 flex flex-col justify-center pt-2">
        <h2 class="text-3xl md:text-4xl font-bold mb-6 font-serif leading-tight text-black">
          {heroTitle}
        </h2>
        <div class="space-y-4 text-gray-600 leading-relaxed text-lg">
          <p>{heroText}</p>
          {heroText2 && <p>{heroText2}</p>}
        </div>
        <div class="mt-8 flex gap-4">
          <a href="/essays" class="px-5 py-2.5 bg-black text-white text-sm font-semibold rounded-sm hover:bg-gray-800 transition-colors">Читать последние эссе</a>
          <a href={telegramLink} target="_blank" class="px-5 py-2.5 bg-gray-100 text-gray-700 text-sm font-semibold rounded-sm border border-gray-200 hover:bg-gray-200 transition-colors">Связаться (Telegram)</a>
        </div>
      </div>
    </div>

  </main>
</Layout>