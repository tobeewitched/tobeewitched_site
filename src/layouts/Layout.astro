---
import '../styles/global.css';
import { getEntry } from 'astro:content';

const siteData = await getEntry('site', 'settings');
const siteTitle = siteData?.data?.siteTitle || 'tobeewitched.';
const siteSubtitle = siteData?.data?.siteSubtitle || 'Академический журнал & Исследовательская база';
const footerText = siteData?.data?.footerText || '© 2024 tobeewitched.';
---

<!DOCTYPE html>
<html lang="ru">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{siteTitle}</title>
  </head>
  <body class="bg-white text-gray-900 font-sans min-h-screen flex flex-col selection:bg-blue-600 selection:text-white">
    
    <div class="max-w-5xl mx-auto px-4 sm:px-6 w-full flex-grow flex flex-col">
      
      <!-- ШАПКА -->
      <header class="pt-16 pb-12 text-center relative border-b border-gray-100">
        <h1 class="text-4xl md:text-5xl font-extrabold tracking-tight text-black font-serif mb-4">{siteTitle}</h1>
        <p class="text-gray-500 text-xs md:text-sm uppercase tracking-[0.2em] font-semibold">{siteSubtitle}</p>
      </header>

      <!-- НАВИГАЦИЯ -->
      <nav class="border-b border-gray-100 mb-12">
        <ul class="flex flex-wrap justify-center gap-x-10 gap-y-4 py-5 text-xs font-bold text-gray-500 uppercase tracking-widest list-none">
          <li><a href="/" class="text-black hover:text-blue-600 transition-colors">Главная</a></li>
          <li><a href="/about" class="hover:text-black transition-colors">Обо мне</a></li>
          <li><a href="/research" class="hover:text-black transition-colors">Исследования</a></li>
          <li><a href="/essays" class="hover:text-black transition-colors">Эссе</a></li>
          <li><a href="/stories" class="hover:text-black transition-colors">Рассказы</a></li>
          <li><a href="/publications" class="hover:text-black transition-colors">Публикации</a></li>
          <!-- ПЕРЕИМЕНОВАЛИ КНОПКУ ЗДЕСЬ -->
          <li><a href="/test" class="hover:text-black transition-colors">Архитектура Воображаемого</a></li>
        </ul>
      </nav>

      <!-- КОНТЕНТ СТРАНИЦ -->
      <div class="flex-grow">
        <slot />
      </div>

      <!-- ПОДВАЛ -->
      <footer class="text-gray-400 text-center py-12 text-sm relative mt-20 border-t border-gray-100">
        <p>{footerText}</p>
        <details class="group absolute bottom-4 left-1/2 -translate-x-1/2 text-gray-300 text-xs cursor-pointer hover:text-yellow-500 transition-colors">
          <summary class="list-none px-4 py-2 outline-none">.</summary>
          <div class="absolute bottom-full left-1/2 -translate-x-1/2 mb-4 w-64 p-5 border border-yellow-500/20 bg-yellow-50 backdrop-blur rounded-lg text-yellow-900 text-sm shadow-xl text-left hidden group-open:block">
            🐝 <b></b>
          </div>
        </details>
      </footer>

    </div>
  </body>
</html>
